# Copy to .env.local for local development (values from `npx supabase status`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER-ONLY. Never prefix with NEXT_PUBLIC_ and never import into client components.
SUPABASE_SERVICE_ROLE_KEY=
# Used in password-reset / invite links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
